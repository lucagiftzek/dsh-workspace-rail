{
  "name": "@lucagiftzek/dsh-workspace-rail",
  "version": "0.2.0",
  "description": "Workspace-first sidebar rail for the DeepSeek Harness web GUI: pinned chats and folders, projects with their own folder and instructions, virtualized Recents, transcript search and unread markers.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "assets",
    "cordis.patch.yml",
    "lib",
    "!lib/**/*.map",
    "!lib/*.map"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "jsdom": "^26.0.0",
    "react": "^18.3.1"
  },
  "author": {
    "name": "Luca Tzekos",
    "url": "https://jobopportunitiesapi.org"
  },
  "homepage": "https://github.com/lucagiftzek/dsh-workspace-rail#readme",
  "bugs": {
    "url": "https://github.com/lucagiftzek/dsh-workspace-rail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucagiftzek/dsh-workspace-rail.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "projects",
    "sidebar",
    "workspace"
  ],
  "publishConfig": {
    "access": "public"
  }
}
